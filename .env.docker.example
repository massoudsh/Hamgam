# Copy to .env next to docker-compose.yml before running `docker compose up -d --build`.

# --- Database ---
POSTGRES_DB=hamgam
POSTGRES_USER=hamgam
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=5432

# --- Host ports ---
BACKEND_PORT=4000
FRONTEND_PORT=3000

# --- Browser-facing API URL (baked into the frontend image at build time) ---
# Local: http://localhost:4000
# Server: https://api.example.com  (rebuild the frontend image after changing it)
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Origins allowed to call the API from a browser (comma-separated, or *) ---
CORS_ORIGIN=http://localhost:3000
