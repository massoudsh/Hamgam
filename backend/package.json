{
  "name": "@hamgam/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hamgam backend API — inventory, order hub, and channel sync engine.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "pg-mem": "^2.8.1",
    "supertest": "^7.0.0",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}
